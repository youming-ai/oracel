# Binance API credentials. Prediction market-data endpoints are signed, so these
# are required in both paper and live modes. Never commit the real .env file.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional when exactly one Prediction wallet is registered. Set these to select
# a wallet explicitly when the account has more than one.
BINANCE_PREDICTION_WALLET_ID=
BINANCE_PREDICTION_WALLET_ADDRESS=
